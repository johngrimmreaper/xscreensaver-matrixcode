<?xml version="1.0" encoding="UTF-8"?>
<screensaver name="matrixcode" _label="MatrixCode 1999 CRT" gl="yes">
  <command arg="-root"/>

  <boolean id="intro" _label="Play Neo terminal intro"
           arg-unset="-no-scene"/>

  <number id="delay" type="slider" arg="-delay %"
          _label="Frame delay" _low-label="Faster" _high-label="Slower"
          low="8333" high="100000" default="33333"/>

  <number id="columns" type="slider" arg="-columns %"
          _label="Code columns" _low-label="Larger glyphs" _high-label="Smaller glyphs"
          low="60" high="120" default="80"/>

  <number id="density" type="slider" arg="-density %"
          _label="Illuminated code" _low-label="Sparse" _high-label="Dense"
          low="25" high="80" default="55"/>

  <number id="speed" type="slider" arg="-speed %"
          _label="Fall speed" _low-label="Slower" _high-label="Faster"
          low="25" high="200" default="40"/>

  <number id="trail" type="slider" arg="-trail %"
          _label="Rain length" _low-label="Shorter" _high-label="Longer"
          low="6" high="40" default="18"/>

  <number id="cycle" type="slider" arg="-cycle %"
          _label="Glyph changes" _low-label="Fewer" _high-label="More"
          low="0" high="250" default="100"/>

  <number id="glow" type="slider" arg="-glow %"
          _label="Optical glow" _low-label="Subtle" _high-label="Strong"
          low="0" high="100" default="76"/>

  <number id="contrast" type="slider" arg="-contrast %"
          _label="Code brightness" _low-label="Dimmer" _high-label="Brighter"
          low="20" high="100" default="82"/>

  <boolean id="crt" _label="1999 CRT display treatment"
           arg-unset="-no-crt"/>

  <number id="curvature" type="slider" arg="-curvature %"
          _label="CRT tube curvature" _low-label="Flat" _high-label="Curved"
          low="0" high="50" default="11"/>

  <number id="scanlines" type="slider" arg="-scanlines %"
          _label="CRT scanlines" _low-label="Subtle" _high-label="Strong"
          low="0" high="70" default="32"/>

  <number id="mask" type="slider" arg="-phosphor-mask %"
          _label="CRT phosphor grille" _low-label="Subtle" _high-label="Strong"
          low="0" high="60" default="14"/>

  <number id="vignette" type="slider" arg="-vignette %"
          _label="CRT edge darkening" _low-label="None" _high-label="Strong"
          low="0" high="70" default="30"/>

  <number id="persistence" type="slider" arg="-persistence %"
          _label="Phosphor persistence" _low-label="Crisp" _high-label="Lingering"
          low="0" high="60" default="14"/>

  <boolean id="vsync" _label="Request vertical synchronization"
           arg-unset="-no-vsync"/>

  <xscreensaver-updater />

  <_description>
+A clean-room reconstruction of original-era Matrix digital rain, tuned around
the first film's 4:3 operator CRT displays. A resolution-independent 80x60
reference density scales its glyph cells from target height and adds columns on wider windows; irregular falling waves then illuminate the grid with pale cursors, restrained bloom,
virtual 640x480 rasterization, scanlines, phosphor texture, persistence,
curvature and edge falloff.
  </_description>
</screensaver>
