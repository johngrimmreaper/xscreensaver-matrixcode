<?xml version="1.0" encoding="UTF-8"?>
<screensaver name="matrixcode" _label="MatrixCode" gl="yes">
  <command arg="-root"/>

  <number id="delay" type="slider" arg="-delay %"
          _label="Frame delay" _low-label="Faster" _high-label="Slower"
          low="8333" high="100000" default="33333"/>

  <number id="cellSize" type="slider" arg="-cell-size %"
          _label="Glyph size" _low-label="Smaller" _high-label="Larger"
          low="10" high="40" default="18"/>

  <number id="density" type="slider" arg="-density %"
          _label="Active columns" _low-label="Sparse" _high-label="Dense"
          low="10" high="90" default="42"/>

  <number id="speed" type="slider" arg="-speed %"
          _label="Fall speed" _low-label="Slower" _high-label="Faster"
          low="25" high="250" default="100"/>

  <number id="trail" type="slider" arg="-trail %"
          _label="Trail length" _low-label="Shorter" _high-label="Longer"
          low="6" high="40" default="18"/>

  <number id="cycle" type="slider" arg="-cycle %"
          _label="Glyph changes" _low-label="Fewer" _high-label="More"
          low="0" high="300" default="100"/>

  <number id="glow" type="slider" arg="-glow %"
          _label="Glow" _low-label="Subtle" _high-label="Strong"
          low="0" high="100" default="68"/>

  <number id="contrast" type="slider" arg="-contrast %"
          _label="Trail contrast" _low-label="Soft" _high-label="Crisp"
          low="20" high="100" default="78"/>

  <boolean id="vsync" _label="Request vertical synchronization"
           arg-unset="-no-vsync"/>

  <xscreensaver-updater />

  <_description>
A clean-room interpretation of the falling digital code aesthetic: a fixed grid
of hand-drawn, half-width katakana-inspired glyphs, mirrored variants, digits
and punctuation illuminated by independently moving pulses. Bright pale heads,
long irregular green tails and a lightweight two-pass glow reproduce the flat,
photographic look without 3D geometry or a shader requirement.
  </_description>
</screensaver>
