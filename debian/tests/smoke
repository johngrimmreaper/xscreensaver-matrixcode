#!/bin/sh
set -eu
program=/usr/libexec/xscreensaver/matrixcode
out=${AUTOPKGTEST_TMP:-/tmp}/matrixcode-autopkgtest.ppm
"$program" -self-test
"$program" -version | grep -F 'matrixcode 0.2.0-film-rework'
LIBGL_ALWAYS_SOFTWARE=1 xvfb-run -a \
  "$program" -window -profile operator1999 -geometry 1280x720 \
  -frames 60 -fps 60 -seed 19990331 -no-vsync -screenshot "$out"
python3 tests/check-ppm.py "$out"
